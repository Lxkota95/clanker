# Loaded by direnv (`direnv allow` once). Contains no secrets: the token is read from the GNOME
# keyring at load time. Store it once with:
#   secret-tool store --label='clanker Discord bot token' service discord app clanker
DISCORD_TOKEN="$(secret-tool lookup service discord app clanker)"
export DISCORD_TOKEN

# Optional: Arenyze API key for /r6verify (free at https://r6.arenyze.com). Store it once with:
#   secret-tool store --label='clanker Arenyze API key' service arenyze app clanker
# Empty when not stored, which leaves /r6verify unregistered.
ARENYZE_API_KEY="$(secret-tool lookup service arenyze app clanker 2>/dev/null)"
export ARENYZE_API_KEY

# Personal settings go in .envrc.local (git-ignored), e.g. your test server's ID, which makes slash
# commands appear there instantly instead of registering globally (up to an hour to show up):
#   export DEV_GUILD_ID=123456789012345678
# (Discord: Settings → Advanced → Developer Mode on, then right-click the server → Copy Server ID)
source_env_if_exists .envrc.local

export RUST_LOG="${RUST_LOG:-clanker=debug,info}"
