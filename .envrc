# Loaded by direnv (`direnv allow` once). Contains no secrets: the token is read from the GNOME
# keyring at load time. Store it once with:
#   secret-tool store --label='clanker Discord bot token' service discord app clanker
DISCORD_TOKEN="$(secret-tool lookup service discord app clanker)"
export DISCORD_TOKEN

# Optional: your test server's ID (Discord: Developer Mode on, right-click the server, Copy Server
# ID) makes slash commands appear instantly there instead of registering globally.
# export DEV_GUILD_ID=123456789012345678

export RUST_LOG="${RUST_LOG:-clanker=debug,info}"
